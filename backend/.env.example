NODE_ENV=development
PORT=5000
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/your_database
# Set true only if your hosted PostgreSQL provider requires TLS.
DATABASE_SSL=false
FRONTEND_ORIGIN=http://localhost:5173
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_REFRESH_SECRET=replace_with_a_different_long_random_secret_at_least_32_chars
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=7
COOKIE_SAME_SITE=lax
# Set true in production when HTTPS is enabled.
COOKIE_SECURE=false
